# PurpleBilling Environment Configuration

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=production
APP_NAME=PurpleBilling
APP_URL=https://billing.purpleapps.com
API_URL=https://api.billing.purpleapps.com
ADMIN_URL=https://admin.billing.purpleapps.com

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=purplebilling
DB_USER=purplebilling_app
DB_PASSWORD=CHANGE_ME_secure_password_here
DB_SSL_MODE=require
DB_MAX_POOL_SIZE=100
DB_CONNECTION_TIMEOUT=30

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0
REDIS_SSL=false
REDIS_CONNECT_TIMEOUT=5000

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=purplebilling_app
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Settings (generate a secure 256-bit key)
JWT_SECRET=CHANGE_ME_generate_secure_256_bit_key_here
JWT_ISSUER=https://billing.purpleapps.com
JWT_AUDIENCE=purplebilling-api
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# OAuth 2.0 / OpenID Connect (Auth0 or custom)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=CHANGE_ME_auth0_client_secret
AUTH0_AUDIENCE=https://api.billing.purpleapps.com

# Alternative: IdentityServer (self-hosted)
# IDENTITY_SERVER_URL=https://identity.purpleapps.com
# IDENTITY_SERVER_CLIENT_ID=purplebilling-api
# IDENTITY_SERVER_CLIENT_SECRET=CHANGE_ME_identity_secret

# =============================================================================
# ENCRYPTION
# =============================================================================
# Master encryption key (AES-256) - Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_generate_base64_encoded_256_bit_key
ENCRYPTION_ALGORITHM=AES-256-GCM

# Azure Key Vault (Optional - for key management)
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=CHANGE_ME_azure_secret

# AWS KMS (Optional - for key management)
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/xxxxx
# AWS_REGION=us-east-1

# =============================================================================
# PAYMENT GATEWAY - STRIPE
# =============================================================================
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_your_stripe_webhook_secret
STRIPE_API_VERSION=2023-10-16

# =============================================================================
# PAYMENT GATEWAY - PAYPAL
# =============================================================================
PAYPAL_CLIENT_ID=CHANGE_ME_your_paypal_client_id
PAYPAL_CLIENT_SECRET=CHANGE_ME_your_paypal_client_secret
PAYPAL_MODE=live  # or 'sandbox' for testing
PAYPAL_WEBHOOK_ID=CHANGE_ME_your_paypal_webhook_id

# =============================================================================
# PAYMENT GATEWAY - SQUARE
# =============================================================================
SQUARE_ACCESS_TOKEN=CHANGE_ME_your_square_access_token
SQUARE_LOCATION_ID=CHANGE_ME_your_square_location_id
SQUARE_ENVIRONMENT=production  # or 'sandbox'
SQUARE_APPLICATION_ID=CHANGE_ME_your_square_app_id

# =============================================================================
# EMAIL SERVICE (SendGrid)
# =============================================================================
SENDGRID_API_KEY=SG.CHANGE_ME_your_sendgrid_api_key
EMAIL_FROM=noreply@purplebilling.com
EMAIL_FROM_NAME=PurpleBilling
EMAIL_REPLY_TO=support@purplebilling.com

# Alternative: Amazon SES
# AWS_SES_ACCESS_KEY_ID=CHANGE_ME
# AWS_SES_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_SES_REGION=us-east-1

# Alternative: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_USE_SSL=true

# =============================================================================
# SMS SERVICE (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME_your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Alternative: Amazon SNS
# AWS_SNS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SNS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_SNS_REGION=us-east-1

# =============================================================================
# FILE STORAGE
# =============================================================================
STORAGE_TYPE=local  # Options: local, s3, azure
STORAGE_PATH=/var/purplebilling/storage

# AWS S3 Storage (Optional)
# AWS_ACCESS_KEY_ID=CHANGE_ME_your_aws_access_key
# AWS_SECRET_ACCESS_KEY=CHANGE_ME_your_aws_secret_key
# AWS_S3_BUCKET=purplebilling-files
# AWS_S3_REGION=us-east-1
# AWS_S3_ENDPOINT=  # Leave empty for standard S3

# Azure Blob Storage (Optional)
# AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME
# AZURE_STORAGE_CONTAINER=purplebilling-files

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_elastic_password

# Log Level
LOG_LEVEL=Information  # Trace, Debug, Information, Warning, Error, Critical
LOG_PATH=/var/log/purplebilling
LOG_MAX_FILE_SIZE_MB=100
LOG_MAX_FILES=30

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST_SIZE=20

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ALLOWED_ORIGINS=https://billing.purpleapps.com,https://admin.purpleapps.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
SESSION_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=15

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_SIZE=4

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=6
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Two-Factor Authentication
REQUIRE_2FA_FOR_ADMIN=true
TOTP_ISSUER=PurpleBilling

# =============================================================================
# COMPLIANCE
# =============================================================================
DATA_RETENTION_YEARS=7
AUDIT_LOG_RETENTION_YEARS=1
SESSION_LOG_RETENTION_DAYS=90

# GDPR
GDPR_ENABLED=true
GDPR_DATA_EXPORT_FORMAT=json

# PCI-DSS
PCI_COMPLIANCE_MODE=true

# =============================================================================
# BUSINESS SETTINGS
# =============================================================================
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,CAD,AUD
TAX_RATE_PERCENTAGE=0
INVOICE_NUMBER_PREFIX=INV
INVOICE_DUE_DAYS=30

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
SEND_INVOICE_EMAILS=true
SEND_PAYMENT_RECEIPTS=true
SEND_PAYMENT_FAILED_NOTIFICATIONS=true
SEND_SUBSCRIPTION_RENEWAL_REMINDERS=true
REMINDER_DAYS_BEFORE_DUE=3

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_SUBSCRIPTIONS_ENABLED=true
FEATURE_MULTI_CURRENCY_ENABLED=true
FEATURE_TAX_CALCULATION_ENABLED=true
FEATURE_AUTOMATED_BILLING=true
FEATURE_DISPUTE_MANAGEMENT=true

# =============================================================================
# DEVELOPMENT / TESTING (Remove in production)
# =============================================================================
# SEED_TEST_DATA=false
# ENABLE_SWAGGER=false
# ENABLE_DEV_EXCEPTION_PAGE=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
CACHE_TTL_SECONDS=900
CACHE_SLIDING_EXPIRATION_SECONDS=300
HTTP_CLIENT_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_SIZE_MB=10

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE_CRON=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_LOCATION=/var/backups/purplebilling

# =============================================================================
# WEBHOOKS
# =============================================================================
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_SECONDS=300
WEBHOOK_TIMEOUT_SECONDS=30

# =============================================================================
# MISC
# =============================================================================
TIMEZONE=UTC
CULTURE=en-US
MAX_UPLOAD_FILE_SIZE_MB=5
ALLOWED_FILE_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.csv,.xlsx
