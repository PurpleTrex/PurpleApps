FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy solution and project files
COPY ["PurpleBilling.sln", "./"]
COPY ["src/PurpleBilling.Api/PurpleBilling.Api.csproj", "src/PurpleBilling.Api/"]
COPY ["src/PurpleBilling.Core/PurpleBilling.Core.csproj", "src/PurpleBilling.Core/"]
COPY ["src/PurpleBilling.Data/PurpleBilling.Data.csproj", "src/PurpleBilling.Data/"]
COPY ["src/PurpleBilling.Services/PurpleBilling.Services.csproj", "src/PurpleBilling.Services/"]
COPY ["src/PurpleBilling.Integrations/PurpleBilling.Integrations.csproj", "src/PurpleBilling.Integrations/"]

# Restore dependencies
RUN dotnet restore "PurpleBilling.sln"

# Copy source code
COPY . .

# Build and publish
WORKDIR "/src/src/PurpleBilling.Api"
RUN dotnet build "PurpleBilling.Api.csproj" -c Release -o /app/build
RUN dotnet publish "PurpleBilling.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

# Security: Run as non-root user
RUN groupadd -r purplebilling && useradd -r -g purplebilling purplebilling
USER purplebilling

# Copy published application
COPY --from=build /app/publish .

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "PurpleBilling.Api.dll"]
